# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=scorefrost
PGPASSWORD=your_password_here
PGDB=scorefrost

# API Configuration
API_PORT=8080
API_MAX_REQUESTS_PER_MINUTE=20

# Solution Hash Salt (used for verifying solution integrity)
SOLUTION_SALT=your_secret_salt_change_in_production

# Dev User API Key (for admin endpoints)
# This key is hashed and stored for the dev user (00000000-0000-0000-0000-000000000001)
DEV_API_KEY=dev_key_change_in_production
